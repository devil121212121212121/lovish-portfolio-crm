# Frontend-safe Supabase credentials (can be exposed in client bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-only credentials (used ONLY in serverless functions /api/leads - NEVER exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional Resend API key for instant email notifications to garglovish938@gmail.com
RESEND_API_KEY=re_your_resend_api_key
